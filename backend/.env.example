# =============================================================================
# EVENTCONNECT BACKEND - VARIABLES DE ENTORNO DE EJEMPLO
# Copia este archivo como .env y reemplaza los valores según tu configuración local.
# IMPORTANTE: Nunca subas tu archivo .env real con credenciales al repositorio.
# =============================================================================

# Configuración del servidor
PORT=3001

# Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_NAME=eventconnect

# URL de conexión completa (opcional/alternativa)
DATABASE_URL=postgresql://postgres:tu_contraseña_postgres@localhost:5432/eventconnect

# Seguridad y Autenticación JWT
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui
JWT_EXPIRES_IN=24h

# Servicio de Correo (Nodemailer / Gmail)
# Para Gmail, genera una contraseña de aplicación en https://myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_gmail

